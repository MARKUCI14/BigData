# Host addresses for scripts run directly on this computer. Docker Compose
# interpolates KAFKA_TOPIC, MONGO_DATABASE, and STREAMLIT_PORT from this file.
# Compose services use Docker-network addresses configured in docker-compose.yml.
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=butterfly-observations
# Docker network: KAFKA_BROKER=kafka:29092

# MongoDB (no credentials are configured in the local Compose setup)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=bigdata
# Docker network: MONGO_URI=mongodb://mongodb:27017

# Spark master
SPARK_MASTER=spark://localhost:7077
# Docker network: SPARK_MASTER=spark://spark-master:7077

# Streamlit
STREAMLIT_PORT=8501
